# ============================================================================
# Aditya-L1 Solar Intelligence Platform - Frontend Dockerfile
# Multi-stage: Build React/Vite SPA -> Serve via optimized Nginx
# ============================================================================

# Stage 1: Build static assets
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first for efficient layer caching
COPY frontend_vf/package.json frontend_vf/package-lock.json* ./
RUN npm ci || npm install

# Copy application source code
COPY frontend_vf/ ./

# Build production bundle (client assets output to dist/public)
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:alpine

# Remove default nginx website
RUN rm -rf /usr/share/nginx/html/*

# Copy built static assets from builder stage
COPY --from=builder /app/dist/public /usr/share/nginx/html

# Copy Nginx reverse proxy and SPA routing configuration
COPY frontend_vf/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
